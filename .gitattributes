# Force LF line endings in the repo; checkout converts on Windows
* text=auto eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.db binary
*.sqlite binary

# Keep shell scripts with LF explicitly
*.sh text eol=lf
